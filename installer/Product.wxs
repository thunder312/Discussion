<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="KI-Diskussion"
             Manufacturer="Daniel Ertl"
             Version="1.0.1.0"
             UpgradeCode="6E821D90-D46B-4A21-BF40-2483A36F8018"
             Language="1033"
             Scope="perUser">

        <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von KI-Diskussion ist bereits installiert." />
        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="ProgramsFolder" Name="Programs">
                <Directory Id="INSTALLFOLDER" Name="KI-Diskussion">
                    <Component Id="MainExecutable" Guid="8F3B2C1A-9D4E-4F6A-8B2C-1A9D4E4F6A8B">
                        <RegistryValue Root="HKCU" Key="Software\KI-Diskussion" Name="Installed"
                                       Type="integer" Value="1" KeyPath="yes" />
                        <File Id="DiscussionExe" Source="publish\Discussion.exe">
                            <Shortcut Id="StartMenuShortcut"
                                      Directory="ProgramMenuFolder"
                                      Name="KI-Diskussion"
                                      WorkingDirectory="INSTALLFOLDER" />
                        </File>
                        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
                        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
                    </Component>
                </Directory>
            </Directory>
        </StandardDirectory>

        <Feature Id="MainFeature" Title="KI-Diskussion" Level="1">
            <ComponentRef Id="MainExecutable" />
        </Feature>
    </Package>
</Wix>
